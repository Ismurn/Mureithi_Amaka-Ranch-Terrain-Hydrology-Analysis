# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# (the template ignored docs/ for pkgdown; this project tracks docs/*.md, so it is NOT ignored)

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# ==============================================================================
# Amaka pipeline (DESCRIPTION.md section 5): code, docs and small CSVs only.
# Raw and derived data stay out of git; folders are kept with .gitkeep.
# ==============================================================================
data/**
!data/
!data/**/
!data/**/.gitkeep
!data/water_pans/water_pans.csv
!data/water_pans/amaka_field_points.csv

outputs/**
!outputs/
!outputs/**/
!outputs/**/.gitkeep

# rasters / archives / spatial exports wherever they land
*.tif
*.tiff
*.zip
*.kml
*.kmz
*.xlsx